\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Imprinted Gate-Irradiance Correlation in PGCC. Top: time-series overlay of learned PV gate and solar irradiance over representative test samples. Bottom: scatter regression confirming a strong Pearson correlation ($r=0.84$, $p < 0.001$) between the explicitly imprinted gate activation and irradiance. The full test-set correlation ($r=0.8306$, $N \approx 430$k) is reported in the text. Note that despite the internal \texttt  {smooth} and normalization constraints, the Pearson correlation rigorously captures their synchronized monotonic variance regardless of the absolute amplitude scale.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:causal_gate}{{3}{5}{Imprinted Gate-Irradiance Correlation in PGCC. Top: time-series overlay of learned PV gate and solar irradiance over representative test samples. Bottom: scatter regression confirming a strong Pearson correlation ($r=0.84$, $p < 0.001$) between the explicitly imprinted gate activation and irradiance. The full test-set correlation ($r=0.8306$, $N \approx 430$k) is reported in the text. Note that despite the internal \texttt {smooth} and normalization constraints, the Pearson correlation rigorously captures their synchronized monotonic variance regardless of the absolute amplitude scale}{figure.3}{}}
